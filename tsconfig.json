{
    "compilerOptions": {
      "target": "ES2020",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "dist",
      "rootDir": "src",
      "ignoreDeprecations": "6.0"
    },
    "ts-node": {
      "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "ignoreDeprecations": "6.0"
      }
    },
    "include": [
      "src"
    ]
  }